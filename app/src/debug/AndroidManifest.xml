<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only: instrumented updater tests serve fixture APK bytes from a
         loopback HTTP server (127.0.0.1), which the platform cleartext default
         blocks at targetSdk 35. The exception names 127.0.0.1 only; the release
         manifest has no networkSecurityConfig and keeps cleartext denied. -->
    <application android:networkSecurityConfig="@xml/sfe_debug_network_security">
        <activity
            android:name=".FolderStatsVisualActivity"
            android:exported="false" />
        <!-- Debug builds only: a local DocumentsProvider so provider-backed file operations can be tested
             without Android/data access. Not part of the release APK. -->
        <provider
            android:name=".TestDocumentsProvider"
            android:authorities="com.stockfileexplorer.app.testdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
