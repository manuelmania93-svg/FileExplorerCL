<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (app/src/debug): allow cleartext HTTP to the loopback
     interface so instrumented updater tests can serve fixture APK bytes from
     127.0.0.1. Never merged into the release manifest. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
